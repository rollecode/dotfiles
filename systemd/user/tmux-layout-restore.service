[Unit]
Description=Bring back tmux sessions with their programs running

# Started by driftwm autostart. The tmux server it starts lives in this unit,
# so stopping or restarting the unit must leave the server running.
[Service]
Type=oneshot
RemainAfterExit=yes
KillMode=process
TimeoutStartSec=5min
ExecStart=%h/.local/bin/tmux-layout-restore
