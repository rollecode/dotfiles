// Zellij, keyed like the tmux config next door: locked by default, Ctrl+a as
// the prefix. Zellij's own modes stay reachable but never capture a keystroke
// that the shell wants.

theme "tokyo-night-purple"
default_layout "default"
default_mode "locked"

mouse_mode true
copy_command "wl-copy"
copy_on_select true
scroll_buffer_size 50000

// Sessions come back after a power cycle or a closed terminal. tmux had no
// equivalent without a plugin.
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 10000

load_plugins {
    "file:~/.config/zellij/plugins/zellij-attention.wasm" {
        waiting_icon "⏳"
        completed_icon "✅"
    }
    "file:~/.config/zellij/plugins/zjframes.wasm" {
        hide_frame_for_single_pane       "true"
        hide_frame_except_for_search     "true"
        hide_frame_except_for_scroll     "true"
        hide_frame_except_for_fullscreen "true"
    }
}

keybinds {
    locked {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
    }

    // The prefix menu. Every binding lands back in Locked, so a keystroke is
    // never swallowed by a mode left open.
    tmux {
        bind "Ctrl a" { SwitchToMode "Locked"; }
        bind "a" { Write 1; SwitchToMode "Locked"; }
        bind "|" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "-" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "%" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "c" { NewTab; SwitchToMode "Locked"; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "&" { CloseTab; SwitchToMode "Locked"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Locked"; }
        bind "i" { TogglePanePinned; SwitchToMode "Locked"; }
        // A pane cannot float if it is the tab's last tiled one, so this opens
        // a new floating shell rather than lifting the current pane.
        bind "f" { Run "bash" { floating true; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "m" { SwitchToMode "Move"; }
        bind "o" { FocusNextPane; SwitchToMode "Locked"; }
        bind "d" { Detach; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "." { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "n" { GoToNextTab; SwitchToMode "Locked"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Locked"; }
        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }
        bind "Left" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Locked"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "[" { SwitchToMode "Scroll"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "r" { SwitchToMode "Resize"; }
        bind "s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }
        bind "Space" { NextSwapLayout; SwitchToMode "Locked"; }
        bind "Esc" { SwitchToMode "Locked"; }
    }

    // Esc and Enter drop all the way back to Locked, not to Normal.
    shared_except "locked" {
        bind "Enter" "Esc" { SwitchToMode "Locked"; }
    }
    shared_except "locked" "entersearch" "renametab" "renamepane" {
        bind "Ctrl a" { SwitchToMode "Locked"; }
    }
}
