// zjstatus bar, shaped like the tmux status line. Everything that changes
// width lives on the left, everything on the right is fixed width, and the
// centre is empty: a centred block shifts on every keystroke of activity.
// Plain glyphs only, no powerline separators: this is read over SSH from a
// phone as often as on the desktop.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "#[bg=#bb9af7,fg=#1a1b26,bold] {session} #[bg=#1a1b26] {pipe_status}{tabs}"
                format_center ""
                format_right  "{notifications}{mode}#[fg=#7aa2f7]{command_host} #[fg=#565f89]· #[fg=#c0caf5]{datetime} "
                format_space  "#[bg=#1a1b26]"
                format_hide_on_overlength "true"

                border_enabled "false"

                mode_locked          "#[fg=#565f89]Ctrl+a "
                mode_tmux            "#[fg=#bb9af7,bold]PREFIX "
                mode_normal          "#[fg=#bb9af7,bold]MENU "
                mode_scroll          "#[fg=#e0af68,bold]SCROLL "
                mode_search          "#[fg=#e0af68,bold]SEARCH "
                mode_enter_search    "#[fg=#e0af68,bold]SEARCH "
                mode_rename_tab      "#[fg=#e0af68,bold]RENAME "
                mode_rename_pane     "#[fg=#e0af68,bold]RENAME "
                mode_default_to_mode "normal"

                tab_normal    "#[fg=#565f89,bg=#1a1b26] {index} {name} "
                tab_active    "#[fg=#bb9af7,bg=#292e42,bold] {index} {name} "
                tab_separator "#[bg=#1a1b26]"

                // Claude Code activity, fed by the cc-zjstatus hook script.
                // The script colours each symbol itself, so no colour here.
                pipe_status_format     "{output} #[fg=#565f89]· "
                pipe_status_rendermode "dynamic"

                notification_format_unread          "#[fg=#e0af68,bold]{message} "
                notification_format_no_notifications ""
                notification_show_interval          "10"

                command_host_command    "uname -n"
                command_host_format     "{stdout}"
                command_host_interval   "0"
                command_host_rendermode "static"

                datetime          "{format}"
                datetime_format   "%H:%M"
                datetime_timezone "Europe/Helsinki"
            }
        }
        children
    }
}
