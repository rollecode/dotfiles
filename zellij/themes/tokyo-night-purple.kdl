            emphasis_1 42 195 222
            emphasis_2 122 162 247
            emphasis_3 0
        }
        frame_highlight {
            base 224 175 104
            background 0
            emphasis_0 187 154 247
            emphasis_1 224 175 104
            emphasis_2 224 175 104
            emphasis_3 224 175 104
        }
        exit_code_success {
            base 158 206 106
