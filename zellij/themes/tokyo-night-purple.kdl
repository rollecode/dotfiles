// Tokyo Night with the purple accent the tmux status line uses (#bb9af7),
// in place of the upstream theme's green. Success and error colours stay
// semantic.
themes {
    tokyo-night-purple {
        text_unselected {
            base 192 202 245
            background 26 27 38
            emphasis_0 255 158 100
            emphasis_1 42 195 222
            emphasis_2 187 154 247
            emphasis_3 122 162 247
        }
        text_selected {
            base 192 202 245
            background 41 46 66
            emphasis_0 255 158 100
            emphasis_1 42 195 222
            emphasis_2 187 154 247
            emphasis_3 122 162 247
        }
        ribbon_selected {
            base 26 27 38
            background 187 154 247
            emphasis_0 249 51 87
            emphasis_1 255 158 100
            emphasis_2 122 162 247
            emphasis_3 158 206 106
        }
        ribbon_unselected {
            base 26 27 38
            background 169 177 214
            emphasis_0 249 51 87
            emphasis_1 192 202 245
            emphasis_2 122 162 247
            emphasis_3 187 154 247
        }
        table_title {
            base 187 154 247
            background 0
            emphasis_0 255 158 100
            emphasis_1 42 195 222
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        table_cell_selected {
            base 192 202 245
            background 41 46 66
            emphasis_0 255 158 100
            emphasis_1 42 195 222
            emphasis_2 187 154 247
            emphasis_3 122 162 247
        }
        table_cell_unselected {
