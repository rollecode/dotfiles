#!/usr/bin/env python3
"""Recreate the tmux sessions recorded by tmux-layout-save and put each one's
foot window back where it was on the canvas.

Sessions are recreated with their old working directory; the program that was
running (claude, ssh) is not relaunched, since resuming those is a decision
rather than a replay. Existing sessions are never touched.
"""
import json
import os
import subprocess
import sys
import time

STATE = os.path.expanduser("~/.local/state/tmux-restore/layout.json")


def env_with_wayland():
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    if "WAYLAND_DISPLAY" not in env:
        rt = env["XDG_RUNTIME_DIR"]
        socks = [f for f in os.listdir(rt)
                 if f.startswith("wayland-") and not f.endswith(".lock")]
        if socks:
            env["WAYLAND_DISPLAY"] = sorted(socks)[0]
    return env


ENV = env_with_wayland()


def existing_sessions():
    r = subprocess.run(["tmux", "list-sessions", "-F", "#{session_name}"],
                       capture_output=True, text=True)
    return set(r.stdout.split()) if r.returncode == 0 else set()


def window_id_for(session):
    """driftwm can only select by app_id, so resolve the numeric id ourselves."""
    try:
        r = subprocess.run(["driftwm", "msg", "state", "--json"],
                           capture_output=True, text=True, timeout=10, env=ENV)
        data = json.loads(r.stdout)
    except Exception:
        return None
    found = []

    def walk(o):
        if isinstance(o, dict):
            if "app_id" in o and "title" in o:
                found.append(o)
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    walk(data)
    for w in found:
        if w.get("app_id") == "foot" and (w.get("title") or "").startswith(session + " ·"):
            return w.get("id")
    return None


def main():
    if not os.path.exists(STATE):
        print("tmux-layout-restore: nothing saved at %s" % STATE, file=sys.stderr)
        return 1
    payload = json.load(open(STATE))
    have = existing_sessions()

    placed = payload.get("windows", [])

    # Sessions that had no window get one anyway, laid out in a row continuing
    # to the right of the rightmost restored window, sharing its baseline.
    GAP = 42
    cursor_x, row_y, fallback = None, None, [1000, 900]
    if placed:
        rightmost = max(placed, key=lambda w: (w.get("position") or [0, 0])[0]
                        + (w.get("size") or fallback)[0])
        rp = rightmost.get("position") or [0, 0]
        rs = rightmost.get("size") or fallback
        cursor_x, row_y = rp[0] + rs[0] + GAP, rp[1]
        fallback = rs

    queue = list(placed)
    for entry in payload.get("detached", []):
        e = dict(entry)
        e["size"] = fallback
        if cursor_x is not None:
            e["position"] = [cursor_x, row_y]
            cursor_x += fallback[0] + GAP
        else:
            e["position"] = None
        queue.append(e)

    for entry in queue:
        name, cwd = entry["session"], entry["cwd"]
        pos, size = entry.get("position"), entry.get("size")
        # Idempotent: a session already on screen keeps the window it has, so
        # running this twice (or after a compositor-only restart) adds nothing.
        if window_id_for(name) is not None:
            print("  %s already has a window, skipping" % name)
            continue
        if name not in have:
            subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", cwd])

        cmd = ["foot"]
        if size and len(size) == 2:
            cmd += ["--window-size-pixels", "%dx%d" % (size[0], size[1])]
        cmd += ["-e", "tmux", "attach", "-t", name]
        subprocess.Popen(cmd, env=ENV,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        wid = None
        for _ in range(40):                      # up to ~8s for the window to map
            time.sleep(0.2)
            wid = window_id_for(name)
            if wid is not None:
                break
        if wid is None:
            print("  %s: window never appeared, not positioned" % name)
            continue
        if pos and len(pos) == 2:
            subprocess.run(["driftwm", "msg", "move", "--id", str(wid),
                            str(pos[0]), str(pos[1])], env=ENV,
                           stdout=subprocess.DEVNULL)
            print("  %s -> id %s at %s" % (name, wid, pos))
        else:
            print("  %s -> id %s (no saved position)" % (name, wid))
    return 0


if __name__ == "__main__":
    sys.exit(main())
