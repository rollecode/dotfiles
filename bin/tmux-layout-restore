#!/usr/bin/env python3
"""Recreate the tmux sessions recorded by tmux-layout-save, detached, with
claude or ssh running in them. With --windows, also put each one's foot window
back where it was on the canvas.

claude resumes the conversation the tmux-session-id.sh hook last saw in that
session. A session with nothing to resume is left out rather than recreated
empty. Existing sessions are never touched.
"""
import json
import os
import shlex
import subprocess
import sys
import time

STATE = os.path.expanduser("~/.local/state/tmux-restore/layout.json")
CLAUDE_IDS = os.path.expanduser("~/.local/state/tmux-restore/claude")
RELAUNCH = {"claude", "ssh"}
RESUME_FLAGS = {"-r", "--resume"}
CONTINUE_FLAGS = {"-c", "--continue"}
WINDOWS_FLAG = "--windows"


def env_with_wayland():
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    if "WAYLAND_DISPLAY" not in env:
        rt = env["XDG_RUNTIME_DIR"]
        socks = [f for f in os.listdir(rt)
                 if f.startswith("wayland-") and not f.endswith(".lock")]
        if socks:
            env["WAYLAND_DISPLAY"] = sorted(socks)[0]
    return env


ENV = env_with_wayland()


def existing_sessions():
    r = subprocess.run(["tmux", "list-sessions", "-F", "#{session_name}"],
                       capture_output=True, text=True)
    return set(r.stdout.split()) if r.returncode == 0 else set()


def window_id_for(session):
    """driftwm can only select by app_id, so resolve the numeric id ourselves."""
    try:
        r = subprocess.run(["driftwm", "msg", "state", "--json"],
                           capture_output=True, text=True, timeout=10, env=ENV)
        data = json.loads(r.stdout)
    except Exception:
        return None
    found = []

    def walk(o):
        if isinstance(o, dict):
            if "app_id" in o and "title" in o:
                found.append(o)
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    walk(data)
    for w in found:
        if w.get("app_id") == "foot" and (w.get("title") or "").startswith(session + " ·"):
            return w.get("id")
    return None


def claude_argv(session, argv):
    """Saved claude flags with --resume pointed at the session's conversation,
    or None when no conversation is known (it would only open the picker)."""
    try:
        sid = open(os.path.join(CLAUDE_IDS, session)).read().strip()
    except OSError:
        sid = ""
    if not sid:
        return None

    out, skip = [], False
    for i, arg in enumerate(argv):
        if skip:
            skip = False
            continue
        if arg in CONTINUE_FLAGS:
            continue
        if arg in RESUME_FLAGS:
            nxt = argv[i + 1] if i + 1 < len(argv) else "-"
            skip = not nxt.startswith("-")
            continue
        out.append(arg)
    return out + ["--resume", sid]


def launch_command(entry):
    """The command to run in a recreated session, or None to leave it out."""
    cmd = entry.get("cmd")
    if cmd not in RELAUNCH:
        return None
    argv = entry.get("argv") or [cmd]
    if cmd == "claude":
        argv = claude_argv(entry["session"], argv)
    return shlex.join(argv) if argv else None


def main():
    if not os.path.exists(STATE):
        print("tmux-layout-restore: nothing saved at %s" % STATE, file=sys.stderr)
        return 1
    payload = json.load(open(STATE))
    have = existing_sessions()

    placed = payload.get("windows", [])

    # Only sessions with something to run come back, never as empty shells.
    for entry in placed + payload.get("detached", []):
        name = entry["session"]
        command = launch_command(entry)
        if name in have or not command:
            continue
        subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", entry["cwd"]])
        # Typed into the interactive shell so it gets the full login env.
        subprocess.run(["tmux", "send-keys", "-t", "=%s:" % name, command, "Enter"])
        print("  %s recreated: %s" % (name, command))

    # Windows only on request: the login restore opens none.
    if WINDOWS_FLAG not in sys.argv[1:]:
        return 0

    have = existing_sessions()
    for entry in placed:
        name = entry["session"]
        if name not in have:
            continue
        pos, size = entry.get("position"), entry.get("size")
        # Idempotent: a session already on screen keeps the window it has, so
        # running this twice (or after a compositor-only restart) adds nothing.
        if window_id_for(name) is not None:
            print("  %s already has a window, skipping" % name)
            continue

        cmd = ["foot"]
        if size and len(size) == 2:
            cmd += ["--window-size-pixels", "%dx%d" % (size[0], size[1])]
        cmd += ["-e", "tmux", "attach", "-t", name]
        subprocess.Popen(cmd, env=ENV,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        wid = None
        for _ in range(40):                      # up to ~8s for the window to map
            time.sleep(0.2)
            wid = window_id_for(name)
            if wid is not None:
                break
        if wid is None:
            print("  %s: window never appeared, not positioned" % name)
            continue
        if pos and len(pos) == 2:
            subprocess.run(["driftwm", "msg", "move", "--id", str(wid),
                            str(pos[0]), str(pos[1])], env=ENV,
                           stdout=subprocess.DEVNULL)
            print("  %s -> id %s at %s" % (name, wid, pos))
        else:
            print("  %s -> id %s (no saved position)" % (name, wid))
    return 0


if __name__ == "__main__":
    sys.exit(main())
