{
  "cleanupPeriodDays": 36500,
  "theme": "custom:tokyonight",
  "env": {
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-permission-destructive.sh",
            "timeout": 10,
            "statusMessage": "Checking for destructive commands"
          }
        ]
      },
      {
        "matcher": "mcp__cronometer__add_custom_food|mcp__cronometer__update_custom_food|mcp__cronometer__create_recipe|mcp__cronometer__update_recipe",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cronometer-aakkoset-hook.py",
            "timeout": 10,
            "statusMessage": "Tarkistetaan ääkköset"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__(linear|claude_ai_Slack|claude_ai_Outline|twenty|timely|claude_ai_Google_Calendar|betterstack)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/personal-guard-hook.py",
            "timeout": 10,
            "statusMessage": "Checking for personal servers and projects"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/codestats-hook.py",
            "async": true
          }
        ]
      },
      {
        "matcher": "sunsama_complete_task|mcp__sunsama__sunsama_complete_task|mcp__linear__save_issue|mcp__plugin_linear_linear__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/append-changelog.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/update-cross-channel-context.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/zellij-attention.sh completed",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/task-list-reminder.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-session-id.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/zellij-attention.sh waiting",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "verbose": true,
  "viewMode": "verbose",
  "bashEditDiffEnabled": false,
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,
  "autoScrollEnabled": true,
  "tui": "fullscreen",
  "effortLevel": "high",
  "remoteControlAtStartup": true,
  "todoFeatureEnabled": true,
  "showExpandedTodos": true
}
